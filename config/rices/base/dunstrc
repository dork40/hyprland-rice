# Catppuccin Mocha accents on black
[global]
    font = JetBrainsMono Nerd Font 10
    width = 340
    height = (0, 200)
    offset = (12, 12)
    origin = top-right
    corner_radius = 10
    frame_width = 2
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    icon_corner_radius = 6
    max_icon_size = 48
    separator_color = frame
    frame_color = "#b4befe"
    highlight = "#cba6f7"
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#000000e6"
    foreground = "#cdd6f4"
    frame_color = "#45475a"
    timeout = 4

[urgency_normal]
    background = "#000000e6"
    foreground = "#cdd6f4"
    timeout = 6

[urgency_critical]
    background = "#000000e6"
    foreground = "#cdd6f4"
    frame_color = "#fab387"
    timeout = 0

[sound]
    script = @HOME@/.config/hypr/scripts/notif-sound.sh
